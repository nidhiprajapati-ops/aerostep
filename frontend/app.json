{
  "expo": {
    "name": "FitPace",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.fitpace.m78wka",
      "infoPlist": {
        "NSMotionUsageDescription": "Track daily steps and reach your fitness goals",
        "NSBluetoothAlwaysUsageDescription": "Connect fitness bands for heart rate and step tracking",
        "NSBluetoothPeripheralUsageDescription": "Connect fitness bands for heart rate and step tracking",
        "NSLocationWhenInUseUsageDescription": "Needed to scan for nearby Bluetooth fitness devices",
        "UIBackgroundModes": ["bluetooth-central", "fetch", "processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.fitpace.m78wka",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Connect fitness bands for heart rate and step tracking"
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
